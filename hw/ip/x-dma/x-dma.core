CAPI=2:

name: x-alp:ip:x-dma
filesets:
  vendor_modules:
    depend:
      - pulp-platform.org::register_interface

  files_rtl:
    depend:
      - pulp-platform.org::common_cells
      - pulp-platform.org::register_interface
    file_type: systemVerilogSource
    files:
      - x_dma_reg_pkg.sv
      - x_dma_reg_top.sv
      - x_dma.sv

targets:
  default:
    filesets:
    - "!target_format ? (!target_lint ? (vendor_modules))"    
    - files_rtl
