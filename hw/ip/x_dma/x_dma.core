CAPI=2:

name: "x-alp:ip:x_dma"
description: "OpenHW Group core-v-mini-mcu soc controller"

# Copyright 2021 OpenHW Group
# Solderpad Hardware License, Version 2.1, see LICENSE.md for details.
# SPDX-License-Identifier: Apache-2.0 WITH SHL-2.1

filesets:

  vendor_modules:
    depend:
      - pulp-platform.org::register_interface

  files_rtl:
    files:
    - rtl/x_dma_reg_pkg.sv
    - rtl/x_dma_reg_top.sv
    - rtl/x_dma.sv
    - rtl/x_dma_pkg.sv
    - rtl/backend/dma_buffer_unit/dma_buffer_control.sv
    - rtl/backend/dma_buffer_unit/dma_buffer_fifos.sv
    - rtl/backend/dma_buffer_unit/dma_buffer_unit.sv
    file_type: systemVerilogSource

  headers:
    files:
    - data/dma_conf.svh: { is_include_file: true }
    file_type: systemVerilogSource

  waivers:
    file_type: vlt
    files:
      - x_dma.vlt

targets:
  default:
    filesets:
    - "!target_format ? (!target_lint ? (vendor_modules))"
    - files_rtl
    - headers
    - tool_verilator ? (waivers)

